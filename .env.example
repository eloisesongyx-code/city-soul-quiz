# ============================================================
# 前端公开配置（会随构建注入浏览器，仅限非敏感值）
# ============================================================
# Supabase 项目 URL，形如 https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key（public 权限，受 RLS 保护）
VITE_SUPABASE_ANON_KEY=your-anon-key

# GitHub Pages 部署路径前缀（项目站点填 /<仓库名>/，用户主页站点填 /）
# 留空则使用 vite.config.ts 中的默认值 /city-soul-quiz/
VITE_BASE_PATH=/city-soul-quiz/

# ============================================================
# 以下值绝不能放入 VITE_* 或任何前端代码！
# 仅用于服务端 Edge Functions / 本地管理脚本，由 GitHub Actions
# secrets 或 Supabase 项目 secrets 提供。
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=  （禁止进入前端）
# SUPABASE_DB_PASSWORD=        （禁止进入前端）
